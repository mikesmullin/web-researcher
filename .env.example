BRAVE_API_KEY=your-brave-search-api-key
# Optional Brave knobs:
# LLM_MODEL=llama-server:default
# BRAVE_COUNTRY=US
BRAVE_SAFESEARCH=moderate   # off | moderate | strict
# BRAVE_COUNT=20
# BRAVE_CACHE_TTL=600
# BRAVE_BASE_URL=https://api.search.brave.com

# --- X (Twitter) API, app-only bearer token (from console.x.com > your app > Keys & Tokens) ---
# The console gives the Bearer token URL-encoded (e.g. %2B = +, %3D = =). Store it DECODED below
# (just the base64 string, no "Bearer " prefix, no trailing whitespace).
X_BEARER_TOKEN=your-decoded-x-api-bearer-token
# Optional X knobs:
# X_BASE_URL=https://api.x.com
# X_COUNT=10
# X_CACHE_TTL=600
