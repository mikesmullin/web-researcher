# Web Researcher — Deep Search agent server (Bun).
#
# Requires BRAVE_API_KEY in @REPO@/.env (see .env.example); the unit loads it via EnvironmentFile.
#
# Installation:
#   bun install
#   cp .env.example .env && $EDITOR .env     # put your Brave Search API key in .env
#   systemctl --user daemon-reload
#   systemctl --user enable --now web-researcher
#
# Logs:
#   journalctl --user -u web-researcher -f

[Unit]
Description=web-researcher - Deep Search agent server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@REPO@
ExecStart=%h/.bun/bin/bun server.mjs
Restart=on-failure
RestartSec=3
Environment=PATH=%h/.bun/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-@REPO@/.env

[Install]
WantedBy=default.target
